 #define SMALL_DEAL (64 * 1024)
 
 #define FDP_RU_SIZE 13079937024ul
+
+// [pilot] TORFS_PID_MAP="a,b,c,d,e" remaps default placement ID i
+// (0 WAL and other files, 1-3 level hints, 4 MANIFEST) to the i-th entry.
+// Unset or empty: unchanged. A missing or non-numeric entry keeps that PID.
+// TORFS_FORCE_PID, when set, is applied after this and wins.
+#include <cstdlib>
+#include <cstring>
+static inline int PilotMapPid(int pid) {
+  const char* map = getenv("TORFS_PID_MAP");
+  if (map == nullptr || map[0] == '\0' || pid < 0) return pid;
+  const char* p = map;
+  for (int i = 0; i < pid; i++) {
+    p = strchr(p, ',');
+    if (p == nullptr) return pid;
+    p++;
+  }
+  char* end = nullptr;
+  long v = strtol(p, &end, 10);
+  if (end == p || v < 0) return pid;
+  return static_cast<int>(v);
+}
