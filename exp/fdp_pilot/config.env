# =====================================================================
# FDP 파일럿 설정 (PC 보정·FEMU 실행 공용, 게스트·호스트 같은 파일)
#   ★ = 환경마다 채울 칸
# =====================================================================

# ---------- 작업 폴더 ----------
WORK="${WORK:-$HOME/fdp_pilot_work}"          # 소스·빌드·결과
RESULTS="${RESULTS:-$WORK/results}"

# ---------- RocksDB / TorFS (Lan 저장소와 같은 조합) ----------
ROCKSDB_TAG="v7.2.2"
TORFS_COMMIT="0a6e399aa3df0b5cd5bbe9d9ccee09d853f3a95a"
LAN_REPO_COMMIT="HEAD"                         # sijielan/FDP_Benchmarking

# ---------- 데이터 ----------
KEY_SIZE=16                 # B
VALUE_SIZE=1024             # B (Lan YCSB 40 KB, README)

# ---------- LSM ----------
# 기준: Lan OPTIONS-000009 의 "usertable" CF (YCSB가 쓰는 CF. "default" CF는 안 씀)
#   Lan: L1 256 / SST 64 / memtable 128 MiB, 레벨 7, multiplier 10, L0 4/20/36,
#        merge 2, memtable 24, dynamic_level_bytes=false, pending 64/256 GiB, delayed 16 MiB/s
# 파일럿: SST·memtable·pending = Lan의 1/128, L1 = 2.5 MiB (1/102.4)
#   L1 2 MiB면 93% 논리(약 19.1 GiB)가 L5 목표(19.53 GiB)의 98% → L6로 넘쳐 키 중복 위험 (11/7 결정)
#   레벨 목표: L1 2.5, L2 25, L3 250, L4 2,500, L5 25,000 MiB (24.41 GiB), L6 250,000 MiB
# 두 사용률·두 정책 공통. lib/dbbench_args.sh 가 CLI로 넘기고 pilot.py optcheck 가 LOG와 대조
LEVEL_BASE_MB=2.5           # max_bytes_for_level_base = 2,621,440 B
TARGET_FILE_MB=0.5          # target_file_size_base = 524,288 B
TARGET_FILE_MULT=1
WRITE_BUFFER_MB=1           # write_buffer_size = 1,048,576 B
LEVEL_MULT=10
NUM_LEVELS=7
L0_TRIGGER=4
L0_SLOWDOWN=20
L0_STOP=36
MIN_WB_MERGE=2
MAX_WB_NUMBER=24
SOFT_PENDING_BYTES=536870912     # 0.5 GiB (Lan 64 GiB / 128)
HARD_PENDING_BYTES=2147483648    # 2 GiB   (Lan 256 GiB / 128)
DELAYED_WRITE_RATE=16777216      # 16 MiB/s (Lan 값, db_bench 기본 8 MiB/s)
BG_JOBS=4
COMPRESSION="none"          # 쓰기량이 압축률에 안 흔들리게 (Lan db_bench도 끔)

# ---------- 장치 (게스트) ----------
DEV_CAPACITY_GIB=24         # 사용자 용량 (= FEMU_DEVSZ_MB)
RU_MIB=128
NG_DEV="/dev/ng0n1"         # ★ 게스트의 문자 장치 (TorFS)
NVME_DEV="/dev/nvme0n1"     # ★ 같은 장치의 블록 장치 (카운터 읽기)

EXPECT_RUHT="II"            # II | PI | any. 파일럿은 모든 RUH II (PI 비교는 갈래 A)

# 정책별 RUH 수 · namespace placement handle 목록 (README "장치 설정")
#   마지막 RUH = GC 전용, namespace에 노출 안 함
#   안 쓰는 RUH도 FEMU가 RU를 열어 두므로 쓰는 RUH만 둠
#   PHS: namespace_phls 형식 (':' 구분 RUH 번호, handle i = i번째 값)
#   02_femu_run.sh 가 run 전에 확인 (devcheck → device.txt), 다르면 중단
NRUH_single=2               # 0 데이터 (TORFS_FORCE_PID=0), 1 GC
PHS_single="0"
NRUH_lan=6                  # 0 WAL / 1 L0–L3 / 2 L4 / 3 L5+ / 4 MANIFEST, 5 GC
PHS_lan="0:1:2:3:4"

TARGET_UTILS="0.70 0.93"    # 최대 사용량(삭제 대기 파일 포함) / 사용자 용량

# 최대 사용량 = SPACE_SLOPE x 논리 + SPACE_FIXED_GIB
#   레벨 크기 고정이라 L1~L4가 거의 일정 → 곱하기 하나보다 이 식이 맞음
#   PC 보정값, 덮어쓰기 1배까지 최대 (results/pc_calib_v3_1x/REPORT.txt)
#     70%: 논리 13.33 → 최대 16.55 GiB / 93%: 논리 18.56 → 최대 21.86 GiB (두 점을 지나는 식)
#   NOFSYNC PC 예비값 → FEMU 실제 사용률은 usage.csv 로 재확인
SPACE_SLOPE=1.0134
SPACE_FIXED_GIB=3.047
SPACE_MARGIN=0.02           # 식 x 1.02 → 실제 최고 = 목표 / 1.02 (93% → 약 91.2%, 70% → 약 68.6%)

# overwrite 양 = 논리 데이터 x OVERWRITE_MULT (키 공간은 늘 --num=N, --writes 만 바뀜)
#   1배 (11/12): RocksDB 증폭 약 24배 → 장치에 약 300~480 GiB(용량의 10~20배) → GC 안정
#   3배는 PC에서 run 하나 41시간. 안정 여부는 summary 가 가운데·뒤 1/3 WAF로 표시
#   밖에서 주면 그 값 (03_host_loop.sh 가 게스트로 넘김)
OVERWRITE_MULT=${OVERWRITE_MULT:-1}
STABLE_TOL=0.05             # 가운데·뒤 1/3 WAF 차가 이보다 크면 "변하는 중"
THREADS=4                   # overwrite 스레드 (load는 1개)
SEED=1
TRACK_STATS=${TRACK_STATS:-1}                  # 1: --stats_per_interval=1, --stats_dump_period_sec (출력만 늘어남)
STATS_INTERVAL_SEC=${STATS_INTERVAL_SEC:-60}
SAVE_FULL_LOG=${SAVE_FULL_LOG:-1}              # LOG 전체 gzip 보관. 큼 (70% load 2시간에 1.37 GB), db_bench 7.2.2에 크기 제한 플래그 없음
OPTCHECK_STRICT=${OPTCHECK_STRICT:-1}          # 옵션 대조 실패 시 1 = 중단, 0 = 기록만
# workload: 균등 랜덤 overwrite. 무너짐 재현 안 되면 다음은 zipfian

# ---------- 판정 (overwrite 뒤 1/3 기준) ----------
# gain = 1 - WAF_lan / WAF_single
MIN_GAIN_LOW=0.10           # 70% gain이 이보다 작으면 보류
COLLAPSE_RATIO=0.5          # gain(93%) / gain(70%) < 이 값 → 무너짐
BORDER_BAND=0.1             # 0.4~0.6 → 경계, 93%만 REP=2

# ---------- 측정 ----------
SAMPLE_SEC=30               # 장치 카운터 읽기 간격(초)

# 장치 카운터: fdpstats = 'nvme fdp stats' (22h) | custom = COUNTER_CMD 가 "host_bytes media_bytes" 출력
COUNTER_METHOD="fdpstats"
FDP_ENDGRP=1
COUNTER_CMD=""              # custom 일 때만

# RUH별 쓰기:
#   femu      : 이 브랜치 FEMU 사용량 로그(C1h). RUH별 host·media·유효 + 실제 사용률 (기본)
#   fdpstatus : 'nvme fdp status' RUAMW 변화로 추정 (실제 FDP SSD용 근사, LBA 단위, 샘플 사이 RU 2개 넘으면 덜 셈)
#   custom    : RUH_CMD 가 "pid bytes" 줄 출력
#   none      : 안 읽음
RUH_METHOD="femu"
RUH_CMD=""
FEMU_USAGE_LID=0xc1         # hw/femu/nvme.h NVME_LOG_FEMU_FDP_USAGE
LBA_BYTES=512               # run마다 'nvme id-ns'로 읽고(lba_bytes), 못 읽을 때만 이 값

# ---------- FEMU 장치 (호스트, femu/start_femu.sh) ----------
# 근거: README "장치 설정" (WARP FAST'26 OP 10%·II, Lan 장치 규모)
#   RU = superblock = 채널 8 x LUN 8 x 512페이지 x 4 KiB = 128 MiB
#   RU 211개 = 사용자 192 x 1.1 (OP 9.9%), GC 75/95 (원본 기본), 모든 RUH II
FEMU_SECSZ=512
FEMU_SECS_PER_PG=8
FEMU_PGS_PER_BLK=512
FEMU_BLKS_PER_PL=211        # = RU 개수 (fdp.nru 도 같은 값)
FEMU_PLS_PER_LUN=1
FEMU_LUNS_PER_CH=8
FEMU_NCHS=8
FEMU_DEVSZ_MB=24576         # 24 GiB
FEMU_GC_THRES=75
FEMU_GC_THRES_HIGH=95
FEMU_ISOLATION_MODE=2       # 모든 RUH II (이 브랜치 추가. 원본 1 = 마지막 RUH만 II)
FEMU_NAND_LAT="pg_rd_lat=40000,pg_wr_lat=200000,blk_er_lat=2000000,ch_xfer_lat=0"   # 원본 run-blackbox-fdp.sh 값

# ---------- FEMU 띄우기 (호스트) — 환경변수로 주면 그 값 ----------
FEMU_BIN="${FEMU_BIN:-}"                   # ★ 이 브랜치 build-femu/qemu-system-x86_64
FEMU_GUEST_IMAGE="${FEMU_GUEST_IMAGE:-}"   # ★ 게스트 qcow2 (RocksDB·TorFS·nvme-cli 설치)
FEMU_GUEST_MEM="${FEMU_GUEST_MEM:-8G}"
FEMU_GUEST_CPUS="${FEMU_GUEST_CPUS:-4}"
FEMU_SSH_PORT="${FEMU_SSH_PORT:-8080}"
# 장치 데이터(24 GiB)를 RAM 대신 이 파일에 (RAM 32 GB 호스트용). run마다 새로 만듦
#   WSL: 리눅스 쪽 경로만 (/mnt/c X). 비우면 원본처럼 RAM + mlock
FEMU_MBE_FILE="${FEMU_MBE_FILE-$HOME/fdp_pilot_femu/ssd_backend.bin}"
FEMU_QMP_SOCK="${FEMU_QMP_SOCK:-$HOME/fdp_pilot_femu/qmp.sock}"
FEMU_SUDO="${FEMU_SUDO:-1}" # 1 = sudo -n 으로 띄움

# ---------- 자동 재시작 (호스트, 03_host_loop.sh) ----------
FEMU_START_CMD=""           # 비우면 femu/start_femu.sh. 직접 쓰면 PILOT_POLICY 를 읽어 foreground로 띄울 것
GUEST_SSH=""                # ★ 예: "femu@localhost"
GUEST_SSH_OPTS="-p ${FEMU_SSH_PORT}"
GUEST_DIR=""                # ★ 게스트 fdp_pilot 경로. 예: "/home/femu/FDP_RL/exp/fdp_pilot"
GUEST_PREP_CMD=""           # (선택) 부팅 뒤 run 전 게스트 명령
BOOT_TIMEOUT_SEC=600
SHUTDOWN_TIMEOUT_SEC=180    # 넘으면 강제 종료
POLL_SEC=60
HOST_RESULTS="${HOST_RESULTS:-$HOME/fdp_pilot_results}"

# 02_femu_run.sh 를 손으로 돌릴 때만: FEMU 초기화 명령. 비우면 run마다 "새로 띄운 뒤 Enter" 질문
FEMU_RESET_CMD=""
