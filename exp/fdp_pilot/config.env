# =====================================================================
# FDP 파일럿 설정 파일
#   - 인구(PC 보정)와 지윤(FEMU 실행)이 같은 파일을 씁니다.
#   - "★ 채울 것" 표시가 있는 줄은 각자 환경에 맞게 바꿔 주세요.
# =====================================================================

# ---------- 작업 폴더 ----------
WORK="${WORK:-$HOME/fdp_pilot_work}"          # 소스·빌드·결과가 쌓이는 곳
RESULTS="${RESULTS:-$WORK/results}"

# ---------- RocksDB / TorFS 버전 ----------
# Lan et al.과 같은 조합입니다. (Lan 저장소: RocksDB 7.2.2 + TorFS 0a6e399)
ROCKSDB_TAG="v7.2.2"
TORFS_COMMIT="0a6e399aa3df0b5cd5bbe9d9ccee09d853f3a95a"
LAN_REPO_COMMIT="HEAD"                         # sijielan/FDP_Benchmarking

# ---------- 데이터 ----------
KEY_SIZE=16                 # 바이트
VALUE_SIZE=1024             # 바이트 (Lan YCSB는 40 KB. 파일럿은 1 KB로 시작, README 참고)

# ---------- LSM 설정 ----------
# 기준: Lan의 YCSB OPTIONS 파일(OPTIONS-000009)에서 YCSB가 쓰는 "usertable" CF.
#   Lan usertable: level_base 256 MiB, target_file 64 MiB, write_buffer 128 MiB,
#                  num_levels 7, multiplier 10, L0 trigger 4 / slowdown 20 / stop 36,
#                  min_write_buffer_to_merge 2, max_write_buffer 24, dynamic_level_bytes=false,
#                  pending 한도 soft 64 / hard 256 GiB, delayed_write_rate 16 MiB/s
#   (같은 파일의 "default" CF 값 512 : 64 : 128 MB, 레벨 6, trigger 2, memtable 6 은 YCSB가 안 써요)
# 파일럿: SST·memtable·pending 한도는 Lan의 1/128, L1은 2.5 MiB (Lan의 1/102.4).
#   L1을 2 MiB(1/128)에서 2.5 MiB로 키운 이유: 2 MiB면 L5 목표가 19.53 GiB라 93%의 논리 데이터(약 19.1 GiB)가
#   L5 목표의 98%가 돼서, L6로 넘쳐 같은 키가 두 레벨에 겹쳐 쌓일 위험이 커요 (11/7 결정 (b)).
#   L1을 키우면 multiplier 10이 그대로라 L1 다음 레벨 목표도 모두 25% 커져요:
#     L1 2.5 MiB, L2 25 MiB, L3 250 MiB, L4 2,500 MiB (2.44 GiB), L5 25,000 MiB (24.41 GiB), L6 250,000 MiB
#     (2 MiB 일 때: 2 / 20 / 200 / 2,000 / 20,000 MiB (19.53 GiB) / 200,000 MiB)
#   L1 : SST 비율은 5 : 1 이 돼요 (Lan 4 : 1).
# 이 값들은 두 사용률·두 정책(single, lan)에 똑같이 써요. lib/dbbench_args.sh 가 CLI로 넘기고,
#   pilot.py optcheck 가 RocksDB LOG의 Options.* 값과 대조해요.
LEVEL_BASE_MB=2.5           # L1 크기(MiB) -> max_bytes_for_level_base = 2,621,440 B
TARGET_FILE_MB=0.5          # SST 크기(MiB) -> target_file_size_base = 524,288 B
TARGET_FILE_MULT=1          # target_file_size_multiplier
WRITE_BUFFER_MB=1           # memtable 크기(MiB) -> write_buffer_size = 1,048,576 B
LEVEL_MULT=10
NUM_LEVELS=7
L0_TRIGGER=4
L0_SLOWDOWN=20              # level0_slowdown_writes_trigger (Lan과 같음)
L0_STOP=36                  # level0_stop_writes_trigger (Lan과 같음)
MIN_WB_MERGE=2
MAX_WB_NUMBER=24
SOFT_PENDING_BYTES=536870912     # soft_pending_compaction_bytes_limit 0.5 GiB (Lan 64 GiB의 1/128)
HARD_PENDING_BYTES=2147483648    # hard_pending_compaction_bytes_limit 2 GiB (Lan 256 GiB의 1/128)
DELAYED_WRITE_RATE=16777216      # 밀렸을 때 쓰기 속도 16 MiB/s (Lan과 같음, db_bench 기본은 8 MiB/s)
BG_JOBS=4                   # 백그라운드 flush+compaction 작업 수 (기록해 둘 값)
COMPRESSION="none"          # 쓰기량 단위가 압축률에 흔들리지 않게 끔 (Lan db_bench와 같음)

# ---------- 장치(FEMU) ----------
DEV_CAPACITY_GIB=24         # ★ 채울 것: FEMU 사용자 용량(GiB)
RU_MIB=128                  # ★ 확인: FEMU RU 크기(MiB)
NG_DEV="/dev/ng0n1"         # ★ 채울 것: FEMU 게스트 안의 문자 장치 (TorFS가 씀)
NVME_DEV="/dev/nvme0n1"     # ★ 채울 것: 같은 장치의 블록 장치 이름 (카운터 읽기용)

# FDP 격리 방식. 파일럿은 모든 RUH가 II (PI 비교는 갈래 A에서).
#   FEMU는 femu-subsys 에 fdp.isolation_mode=2 를 줘서 띄워야 해요 (이 브랜치에서 추가한 값).
#   원본의 isolation_mode=1 은 마지막 RUH만 II 라서, 데이터를 쓰는 RUH는 PI 가 돼요.
#   02_femu_run.sh 가 run 전에 'nvme fdp configs'로 PID 0 ~ NUM_PIDS-1 의 RUH 종류를 확인하고,
#   EXPECT_RUHT 와 다르면 멈춰요. any 면 확인하지 않아요.
EXPECT_RUHT="II"            # II | PI | any
NUM_PIDS=5                  # TorFS가 쓰는 PID 수 (WAL, L0–L3, L4, L5, MANIFEST)

# 목표 장치 사용률 = (삭제 대기 파일까지 포함한) 최대 사용량 / 사용자 용량
TARGET_UTILS="0.70 0.93"

# 최대 사용량 = SPACE_SLOPE x 논리 데이터 + SPACE_FIXED_GIB  (기울기 + 고정량)
#   레벨 크기를 고정(dynamic_level_bytes=false)해서 L1~L4가 데이터 양과 상관없이 거의 일정해요.
#   그래서 곱하기 하나(공간 증폭)보다 이 식이 두 사용률에 다 맞아요.
#   ★ 아래 두 값은 아직 "임시"예요. 이 설정(L1 2.5 MiB, 레벨 7)으로 실측한 값이 아니에요.
#     - SPACE_SLOPE=1.034 : L1 4 MiB·레벨 6·overwrite 1배·NOFSYNC=1 이었던 이전 보정에서 온 값
#     - SPACE_FIXED_GIB=2.6875 : 2.15 x (2.5 / 2) 로 키운 임시 초기 추정 (2.15 도 보정 전 추정이었음).
#       참고로 이전 실측 고정량 4.30 GiB(L1 4 MiB) x (2.5 / 4) 도 2.6875 예요.
#   이 임시값은 예비 키 수(N)를 정하는 데만 써요. 최종값은 같은 새 설정으로 70%·93%를 보정한 뒤
#     python3 pilot.py pcfit <70% 폴더> <93% 폴더> 로 다시 맞춰서 바꿔야 해요.
SPACE_SLOPE=1.034           # 임시 (새 설정 실측 아님)
SPACE_FIXED_GIB=2.6875      # 임시 초기 추정 (새 설정 실측 아님)
# 여유: 계산엔 (SPACE_SLOPE x 논리 + SPACE_FIXED_GIB) x (1 + SPACE_MARGIN)을 써요.
#   즉 모델상 실제 최고 사용률 = 목표 / 1.02 예요: 목표 93% -> 약 91.2%, 목표 70% -> 약 68.6%.
#   (식이 정확하다면 실제 최고는 목표보다 낮게 잡혀요. 목표나 여유를 바꿀 땐 지윤과 먼저 정하기)
SPACE_MARGIN=0.02

# overwrite 단계에서 쓸 양 = 논리 데이터 크기 × OVERWRITE_MULT
#   키 공간은 항상 --num=N 이고, 덮어쓰기 횟수만 --writes(스레드당) x THREADS 로 정해요.
#   밖에서 정하면 그 값이 쓰여요: OVERWRITE_MULT=1 ./01_pc_calibrate.sh
#   FEMU: 03_host_loop.sh 가 호스트에서 정한 값을 게스트로 넘겨요.
OVERWRITE_MULT=${OVERWRITE_MULT:-3}
THREADS=4                   # overwrite 스레드 수 (load는 항상 1개)
SEED=1
# 추적용 통계 (RocksDB 동작은 안 바뀌고 출력만 늘어요). 1이면 db_bench 에
#   --stats_per_interval=1 (60초마다 db_bench 출력에 레벨별 크기·stall 통계)
#   --stats_dump_period_sec=60 (LOG 에도 60초마다 같은 통계) 를 더해요.
TRACK_STATS=${TRACK_STATS:-1}
STATS_INTERVAL_SEC=${STATS_INTERVAL_SEC:-60}   # 진행·통계 출력 간격(초): --stats_interval_seconds, --stats_dump_period_sec
# run이 끝나면 RocksDB LOG 전체를 gzip 으로 결과 폴더에 남겨요 (L5->L6 compaction·stall 추적용).
#   LOG가 커요: L1 2 MiB 70% load에서 2시간에 1.37 GB (대부분 SST마다 남는 table_file_creation 기록).
#   db_bench 7.2.2 에는 max_log_file_size·keep_log_file_num 플래그가 없어 LOG 크기를 줄일 수 없어요.
SAVE_FULL_LOG=${SAVE_FULL_LOG:-1}
# 옵션 확인이 실패하면 run을 멈출지 (1 = 멈춤, 0 = 기록만 하고 계속)
OPTCHECK_STRICT=${OPTCHECK_STRICT:-1}
# workload: 균등 랜덤 overwrite로 먼저 돌려요.
#   이득 무너짐이 재현되지 않으면 그다음에 zipfian(Lan의 YCSB-A처럼 일부 키에 쓰기 쏠림)을 시도해요.

# ---------- 판정 ----------
# gain = 1 - WAF_lan / WAF_single  (overwrite 뒤 1/3 기준)
MIN_GAIN_LOW=0.10           # 70%에서 gain이 이보다 작으면 판정하지 않음 (비율이 의미 없어서)
COLLAPSE_RATIO=0.5          # gain(93%) / gain(70%) 이 이보다 작으면 "무너짐"
BORDER_BAND=0.1             # 0.4~0.6 이면 경계 -> 93% 두 run을 한 번 더 (REP=2)

# ---------- 측정 ----------
SAMPLE_SEC=30               # 장치 카운터를 몇 초마다 읽을지

# 장치 카운터 읽는 방법
#   fdpstats : nvme-cli의 'nvme fdp stats' (FDP 통계 로그 페이지)를 읽음
#   custom   : 아래 COUNTER_CMD가 "host_bytes media_bytes" 두 숫자를 한 줄로 출력
COUNTER_METHOD="fdpstats"
FDP_ENDGRP=1
COUNTER_CMD=""              # ★ custom일 때 채울 것 (예: FEMU 통계를 읽는 스크립트)

# RUH(PID)별 쓰기 확인 방법
#   femu      : 이 브랜치(fdp-pilot) FEMU의 사용량 로그(vendor log C1h)를 읽음 (기본)
#               RUH별 host·media 쓰기량이 정확하게 나오고, 장치의 실제 사용률
#               (유효 데이터 / 용량)도 같이 기록돼요 (usage.csv, ruh_usage.csv)
#   fdpstatus : 'nvme fdp status'의 RUH별 남은 쓰기량(RUAMW) 변화로 추정 (Lan 방식, 실제 FDP SSD용 근사)
#               RUAMW는 LBA 단위예요 (LBA 크기는 장치에서 읽어요, 아래 LBA_BYTES).
#               샘플 사이에 RU를 두 개 넘게 쓰면 덜 세요
#   custom    : RUH_CMD가 "pid bytes" 줄들을 출력
#   none      : 안 읽음
RUH_METHOD="femu"
RUH_CMD=""
FEMU_USAGE_LID=0xc1         # femu: 사용량 로그 번호 (hw/femu/nvme.h NVME_LOG_FEMU_FDP_USAGE)
LBA_BYTES=512               # LBA 크기(B)는 run마다 'nvme id-ns'로 읽어 run 폴더의 lba_bytes 에 남겨요.
                            #   이 값은 그걸 못 읽었을 때만 써요 (FEMU 기본 512, 실제 FDP SSD는 보통 4096)

# ---------- FEMU 자동 재시작 (03_host_loop.sh, 호스트에서 씀) ----------
# run마다 FEMU를 새로 띄워 FTL을 깨끗하게 만들어요. 이 칸들은 호스트의 config.env 에만 채우면 돼요.
FEMU_START_CMD=""           # ★ 지윤: FEMU를 "앞에서(foreground)" 띄우는 명령. 예: "cd ~/femu/build-femu && ./run-fdp.sh"
GUEST_SSH=""                # ★ 지윤: 게스트 접속 주소. 예: "femu@localhost"
GUEST_SSH_OPTS="-p 8080"    # ★ 지윤: ssh 옵션 (포트 포워딩 등)
GUEST_DIR=""                # ★ 지윤: 게스트 안의 fdp_pilot 폴더 경로. 예: "/home/femu/fdp_pilot"
GUEST_PREP_CMD=""           # (선택) 부팅 뒤 run 전에 게스트에서 돌릴 명령. 예: FDP 네임스페이스 만들기
BOOT_TIMEOUT_SEC=600        # FEMU 부팅을 기다리는 최대 시간
SHUTDOWN_TIMEOUT_SEC=180    # 끄기를 기다리는 최대 시간 (넘으면 강제 종료)
POLL_SEC=60                 # run이 끝났는지 확인하는 간격
HOST_RESULTS="${HOST_RESULTS:-$HOME/fdp_pilot_results}"   # 결과를 호스트로 가져올 폴더

# 손으로 돌릴 때(02_femu_run.sh 직접 실행)만 씀: FEMU를 깨끗하게 만드는 명령.
#   비워 두면 run마다 "FEMU를 새로 띄운 뒤 Enter"를 물어봐요. 03_host_loop.sh를 쓰면 필요 없어요.
FEMU_RESET_CMD=""
